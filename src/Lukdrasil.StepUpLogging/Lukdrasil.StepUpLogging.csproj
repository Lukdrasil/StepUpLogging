<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- Package Metadata -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Lukdrasil.StepUpLogging</PackageId>
    <Version>5.2.0</Version>
    <PackageReleaseNotes>v5.2.0 - Stalled drain made visible (#71): audit_spool_oldest_age_seconds gauge, opt-in health signal (EncryptedSpoolOptions.OldestRecordMaxAge, OldestRecordStatus), a reason tag on audit_spool_dead_lettered_total, and the documented answer for an unknown key (503 while keys load, 422 when gone). See CHANGELOG.md. v5.1.0 - Encrypted spool throughput (#69): opt-in batched delivery (EncryptedSpoolOptions.DeliveryBatchSize, POST {EndpointBaseUrl}/audit/batch; default 1 keeps the wire unchanged); concurrent durable writes no longer queue behind one gate, the cap still holds; a full spool refuses from its tally and re-checks the disk at most once per SpoolFullRecheckInterval instead of scanning the directory on every write; dropped records are logged at Critical at a bounded rate. See CHANGELOG.md.</PackageReleaseNotes>
    <Authors>Lukdrasil</Authors>
    <Description>Dynamic step-up logging for ASP.NET Core with Serilog - automatically increase log verbosity when errors occur, with minimal performance overhead. Includes request body capture, sensitive data redaction, and OpenTelemetry metrics.</Description>
    <PackageTags>serilog;logging;aspnetcore;observability;otel;stepup;dynamic-logging;error-logging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Lukdrasil/StepUpLogging</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Lukdrasil/StepUpLogging</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    
    <!-- Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Update="buildTransitive\Lukdrasil.StepUpLogging.targets" Pack="true" PackagePath="buildTransitive/net10.0/Lukdrasil.StepUpLogging.targets" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>Lukdrasil.StepUpLogging.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
        <_Parameter1>Lukdrasil.StepUpLogging.Benchmarks</_Parameter1>
    </AssemblyAttribute>
</ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.OpenTelemetry" Version="1.0.1" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageReference Include="Serilog.Exceptions" Version="8.4.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Enrichers.Process" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.CallStack" Version="1.0.358" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" PrivateAssets="build;buildtransitive;analyzers;contentfiles" />
  </ItemGroup>

</Project>
