<Project>

  <Target Name="_LukdrasilStepUpLoggingRemoveTelemetryGenerators"
          AfterTargets="ResolvePackageAssets;ResolveReferences"
          Condition="'$(DisableMicrosoftExtensionsLoggingSourceGenerator)' != 'true'">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.NuGetPackageId)' == 'Microsoft.Extensions.Telemetry.Abstractions'" />
    </ItemGroup>
  </Target>

</Project>
