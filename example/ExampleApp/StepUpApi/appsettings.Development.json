{
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "SerilogStepUp": {
        "Mode": "AlwaysOn",
        "StepUpLevel": "Debug",
        "EnableOtlpExporter": true,
        "EnableConsoleLogging": true,
        "CaptureRequestBody": true,
        "MaxBodyCaptureBytes": 8192,
        "RedactionRegexes": [
            "password=[^&]*",
            "authorization:.*"
        ]
    }
}